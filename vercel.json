{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "frontend": {
      "root": "Frontend",
      "framework": "vite"
    },
    "frontend-2": {
      "root": "The-Master-Academy-UAE/Frontend",
      "framework": "vite"
    },
    "backend": {
      "root": "Backend",
      "framework": "express"
    },
    "backend-2": {
      "root": "The-Master-Academy-UAE/Backend",
      "framework": "express"
    }
  },
  "rewrites": [
    {
      "source": "/uae-api/(.*)",
      "destination": {
        "service": "backend-2"
      }
    },
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/uae/(.*)",
      "destination": {
        "service": "frontend-2"
      }
    },
    {
      "source": "/uae",
      "destination": {
        "service": "frontend-2"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "frontend"
      }
    }
  ]
}
