{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "node build-all.js",
  "outputDirectory": "Frontend/dist",
  "rewrites": [
    {
      "source": "/uae-api/:path*",
      "destination": "https://the-masteracademy.onrender.com/api/:path*"
    },
    {
      "source": "/api/:path*",
      "destination": "https://master-academy-api.onrender.com/api/:path*"
    },
    {
      "source": "/uae",
      "destination": "/uae/index.html"
    },
    {
      "source": "/uae/:path*",
      "destination": "/uae/index.html"
    },
    {
      "source": "/((?!api/|uae-api/).*)",
      "destination": "/index.html"
    }
  ]
}
