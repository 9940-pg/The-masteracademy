{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "node build-all.js",
  "outputDirectory": "Frontend/dist",
  "rewrites": [
    {
      "source": "/uae",
      "destination": "/uae/index.html"
    },
    {
      "source": "/uae/:path*",
      "destination": "/uae/index.html"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
